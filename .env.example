# --- app ---
ENVIRONMENT=local
DEBUG=true
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000"]

# --- database ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5434
POSTGRES_USER=barberhub
POSTGRES_PASSWORD=barberhub
POSTGRES_DB=barberhub

# --- auth ---
JWT_SECRET_KEY=change-me-in-production-please-use-openssl-rand-hex-32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- booking rules ---
SLOT_STEP_MINUTES=15
MIN_BOOKING_LEAD_MINUTES=30
APPOINTMENT_CHANGE_CUTOFF_MINUTES=120
DEFAULT_TIMEZONE=Asia/Almaty

# --- operations ---
LOG_LEVEL=INFO
RATE_LIMIT_ENABLED=true

# --- redis / celery ---
REDIS_URL=redis://localhost:6380/0
# Set false to skip queueing notification tasks (used by the test suite)
NOTIFICATIONS_ENABLED=true

# --- smtp (mailhog in dev) ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=false
EMAILS_FROM_EMAIL=no-reply@barberhub.local
EMAILS_FROM_NAME=BarberHub
